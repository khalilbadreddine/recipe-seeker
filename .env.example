# Copy to .env and fill in. Never commit real keys.
# Get a free key (1,000 req/hr) at https://fdc.nal.usda.gov/api-key-signup
# Without it the build falls back to DEMO_KEY (~30 req/hr) + on-disk cache.
FDC_API_KEY=

# API port (default 3001)
PORT=3001

# --- Vercel functions (api/chat.mjs, api/subscribe.mjs) ----------------------
# Set these in Vercel → Project → Settings → Environment Variables.
# For local testing with `npm run api:dev`, put them in this repo-root .env.
# AI chat: at least one key (all free tiers). Without one, chat runs in basic mode.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Optional override when a :free model is retired (comma-separated)
# OPENROUTER_CHAT_MODELS=
# Newsletter signups (also run supabase/site-features.sql once)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
