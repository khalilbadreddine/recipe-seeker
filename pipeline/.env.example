# Copy to .env (repo root) and fill in. NEVER commit .env.
# Verify: git check-ignore .env   (must print ".env")

# --- Supabase (same project the site uses) ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...            # SECRET service_role key (server-side only!)

# --- Pinterest (see pipeline/docs/pin-scheduler-guide.md) ---
PINTEREST_ACCESS_TOKEN=pina_...
PINTEREST_BOARD_ID=123456789012345
PINTEREST_REGION=US
PINTEREST_TREND_TYPE=growing                  # growing | monthly | yearly | seasonal

# --- Pipeline tuning ---
SITE_URL=https://recipe-seeker-client.vercel.app
MAX_KEYWORDS_PER_DAY=5                        # miner cap (guardrail P4)
DRAFTS_PER_DAY=3                              # generator cap (guardrail P4)
PIN_SPACING_HOURS=6                           # spacing between scheduled pins

# --- Draft generator LLM (fallback chain — first configured+working wins) ---
# Order is Khalil's choice: xAI Grok -> OpenRouter :free -> NVIDIA NIM -> Gemini (last).
# All four have free tiers, no credit card. Set at least ONE.
LLM_PROVIDER=auto                             # auto | manual
XAI_API_KEY=<redacted>                  # console.x.ai — $25 signup credits, no card
# XAI_MODEL=grok-4-1-fast                     # override if you want another Grok model
OPENROUTER_API_KEY=<redacted>           # openrouter.ai/keys — :free models
NVIDIA_API_KEY=<redacted>               # build.nvidia.com — free credits
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
GEMINI_API_KEY=<redacted>               # aistudio.google.com — free tier (last resort)
